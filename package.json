{
  "name": "vaticr",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous DeAI headline-driven market maker for DreamDEX Event Contracts on Somnia.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "vendor/ec-core",
    "bot"
  ],
  "scripts": {
    "bot:start": "node scripts/start.mjs",
    "bot:dry": "cross-env DRY_RUN=true node scripts/start.mjs",
    "doctor": "npm run doctor -w @vaticr/bot",
    "api": "node -e \"const{existsSync}=require('fs');const p=existsSync('.venv/bin/python')?'.venv/bin/python':'python3';require('child_process').spawn(p,['-m','uvicorn','agents.server:app','--host',process.env.VATICR_API_HOST||'127.0.0.1','--port',process.env.VATICR_API_PORT||'8787'],{stdio:'inherit'})\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @vaticr/bot",
    "compile": "hardhat compile",
    "deploy:registry": "hardhat run scripts/deploy-registry.cjs --network somniaTestnet",
    "backstop": "npm run backstop -w @vaticr/bot",
    "test:contracts": "hardhat test",
    "test:agents": "node -e \"const{existsSync}=require('fs');const p=existsSync('.venv/bin/python')?'.venv/bin/python':'python3';const{readdirSync}=require('fs');const ms=readdirSync('tests').filter(f=>/^test_.*\\\\.py$/.test(f)).map(f=>'tests.'+f.slice(0,-3)).sort();let fail=0;for(const m of ms){const r=require('child_process').spawnSync(p,['-m',m],{stdio:'inherit'});if(r.status!==0)fail=1;}process.exit(fail)\"",
    "bot:only": "npm start -w @vaticr/bot",
    "test": "npm run test:agents && npm run test:bot && npm run test:contracts",
    "setup": "npm install && pip install -r requirements.txt",
    "test:bot": "npm test -w @vaticr/bot",
    "backtest": "node -e \"const{existsSync}=require('fs');const p=existsSync('.venv/bin/python')?'.venv/bin/python':'python3';require('child_process').spawn(p,['-m','agents.backtest',...process.argv.slice(1)],{stdio:'inherit'})\" --"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.427.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
