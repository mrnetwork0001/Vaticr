# ============================================================================
#  VATICR - copy to .env and edit.  `cp .env.example .env`
#  Everything below has a working default; the only thing you must add to
#  trade for real is PRIVATE_KEY.
# ============================================================================

# ---- Network ---------------------------------------------------------------
# testnet = Somnia Shannon, chainId 50312, gas in STT, collateral tUSDC (6 dp).
# Gas faucet: https://testnet.somnia.network/  ·  explorer:
# https://shannon-explorer.somnia.network/   See README "Funding a testnet run".
NETWORK=testnet
# RPC_URL=https://api.infra.testnet.somnia.network

# The DreamDEX event-contract venue to trade.
#
# REQUIRED in practice: several venues run side by side on one deployment and
# the Bot Kit refuses to guess between them. These ids MOVE - both networks
# changed theirs three times in one week - so if the bot reports no markets,
# read the current one off a live market row (`npm run doctor` prints it).
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
# mainnet: 0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d

# ---- Safety ----------------------------------------------------------------
# true  = log every order, send nothing (default, and how you should start)
# false = trade for real; requires a funded PRIVATE_KEY
DRY_RUN=true

# Funded key for writes. Use a hot key that holds only what you can lose;
# see the Bot Kit's session-keys guide for a key that cannot withdraw.
# It needs STT for gas before it can do anything, including calling the tUSDC
# faucet. `npm run doctor` prints both balances and fails on either being zero.
# PRIVATE_KEY=0x...

# tUSDC collateral top-up. ec-core's seedInventory() calls the public
# faucet(uint256) on 0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E whenever the
# signer holds under 1,000 tUSDC. On by default off mainnet; there is no faucet
# on mainnet, where collateral is real USDso.
# FAUCET_ENABLED=true

# ---- Intelligence layer ----------------------------------------------------
VATICR_API_HOST=127.0.0.1
VATICR_API_PORT=8787
VATICR_API_URL=http://127.0.0.1:8787

# ---- Scout (news ingestion) ------------------------------------------------
# Comma-separated RSS/Atom feeds. The defaults are keyless and public.
# VATICR_NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
VATICR_SCOUT_POLL_SEC=45
# Optional keyed source; skipped silently when unset.
# CRYPTOPANIC_TOKEN=

# ---- LLM headline classifier (optional) ------------------------------------
# Without a key Vaticr uses its deterministic lexicon scorer, which needs no
# network and no credentials. With one, Claude re-scores headlines for surprise
# rather than keywords.
# ANTHROPIC_API_KEY=sk-ant-...
VATICR_LLM_MODEL=claude-opus-5
VATICR_LLM_ENABLED=true

# ---- Bayesian engine -------------------------------------------------------
# Scaling on headline evidence, in log-odds.
VATICR_EVIDENCE_KAPPA=0.50
# Hard cap on total news evidence, both directions.
VATICR_EVIDENCE_CAP=1.20
# Half-life of headline evidence, seconds.
VATICR_EVIDENCE_HALF_LIFE_SEC=1800
# Grid the oracle price series is resampled onto before differencing. Do not
# lower this: the feed is an EMA at 1s resolution, and differencing it raw
# measures the smoothing rather than the volatility (see agents/pricing.py).
VATICR_VOL_STEP_SEC=30
VATICR_FALLBACK_VOL=0.35

# ---- Trading -----------------------------------------------------------------
# Minimum edge over the TOUCH before crossing the spread. Taking is how a
# signal bot bleeds - this must clear the spread, not the mid.
VATICR_EDGE_THRESHOLD=0.05
# How far THROUGH the touch an IOC is priced. One tick here is 0.001, so this is
# five ticks of headroom: an IOC priced at exactly the touch no-fills the moment
# the book moves between the read and the send, and a no-fill still costs gas.
VATICR_TAKE_BUFFER=0.005
# Half-spread around the posterior when resting a two-sided mint-a-pair quote.
VATICR_HALF_SPREAD=0.03
VATICR_QUOTE_SIZE=5
VATICR_MAX_NET_INVENTORY=25
# Cumulative collateral this process may commit over its whole run. Deliberately
# small: the rail should bite on a misconfigured run and be raised on purpose,
# not discovered after the wallet is empty.
VATICR_MAX_NOTIONAL=50
VATICR_MAX_MARKETS=8
VATICR_REFRESH_MS=10000
VATICR_ORDER_TTL_SEC=90
# Restrict to one underlying, e.g. BTC. Blank = whatever the venue runs.
EC_UNDERLYING=

# ---- Forecast commitments --------------------------------------------------
# Post each forecast to the API before its window closes so it can be
# Brier-scored afterwards. Off means no track record.
VATICR_COMMIT_FORECASTS=true

# ---- On-chain forecast registry (optional) ---------------------------------
# Deploy with: npm run deploy:registry  (writes deployments/50312.json)
# Set this and the bot publishes each forecast on-chain before its window
# closes, so the track record is auditable by someone who does not trust it.
# VATICR_REGISTRY=0x...
# NEXT_PUBLIC_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# ---- Claiming (Bot Kit) ----------------------------------------------------
# Winnings are claimed, not received. The bot sweeps settled markets each loop.
AUTO_CLAIM=true
AUTO_CLAIM_INTERVAL_MS=600000
CLAIM_SCAN=25
